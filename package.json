{
  "name": "exam-analytics-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run server/server.ts",
    "build": "vite build && esbuild server/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:dataset": "esbuild scripts/build-dataset.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/build-dataset.mjs && node node_modules/.cache/build-dataset.mjs",
    "export-data": "esbuild scripts/export-data.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/export-data.mjs && node node_modules/.cache/export-data.mjs",
    "import:supabase": "esbuild scripts/import-supabase.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/import-supabase.mjs && node node_modules/.cache/import-supabase.mjs",
    "build:static": "npm run export-data && vite build",
    "deploy": "npm run build:static && wrangler pages deploy dist --project-name ketquathithumitht --branch main",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.35.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "typescript": "~5.8.2",
    "wrangler": "^4.145.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  }
}
