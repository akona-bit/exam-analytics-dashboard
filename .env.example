# Supabase configuration
# Create a project at https://supabase.com and copy these values from Settings > API
#
# Bỏ trống cả hai biến này thì app tự chạy bằng /api hoặc file JSON tĩnh
# trong public/data/ (sinh ra bởi `npm run export-data`).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Chỉ dùng khi chạy `npm run import:supabase` ngoài trình duyệt.
# KHÔNG đặt các biến này vào file .env của frontend — chúng không có tiền tố VITE_
# nên Vite không nhúng chúng vào bundle, nhưng đừng commit key service_role.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_EMAIL=
# SUPABASE_PASSWORD=